-- id variables
RESET ROLE;
SELECT (SELECT id FROM harness.ids WHERE k='loc_a') AS loc_a,
  (SELECT id FROM harness.ids WHERE k='loc_b') AS loc_b,
  (SELECT id FROM harness.ids WHERE k='league_a') AS league_a,
  (SELECT id FROM harness.ids WHERE k='league_b') AS league_b,
  (SELECT id FROM harness.ids WHERE k='course_a') AS course_a,
  (SELECT id FROM harness.ids WHERE k='course_b') AS course_b,
  (SELECT id FROM harness.ids WHERE k='p1') AS p1,
  (SELECT id FROM harness.ids WHERE k='p2') AS p2,
  (SELECT id FROM harness.ids WHERE k='p3') AS p3,
  (SELECT id FROM harness.ids WHERE k='p4') AS p4,
  (SELECT id FROM harness.ids WHERE k='p5') AS p5,
  (SELECT id FROM harness.ids WHERE k='p6') AS p6,
  (SELECT id FROM harness.ids WHERE k='p7') AS p7,
  (SELECT id FROM harness.ids WHERE k='p8') AS p8,
  (SELECT id FROM harness.ids WHERE k='p9') AS p9,
  (SELECT id FROM harness.ids WHERE k='pb1') AS pb1,
  (SELECT id FROM harness.ids WHERE k='pb2') AS pb2,
  (SELECT id FROM harness.ids WHERE k='t1') AS t1,
  (SELECT id FROM harness.ids WHERE k='t2') AS t2,
  (SELECT id FROM harness.ids WHERE k='t3') AS t3,
  (SELECT id FROM harness.ids WHERE k='t4') AS t4,
  (SELECT id FROM harness.ids WHERE k='tb1') AS tb1,
  (SELECT id FROM harness.ids WHERE k='e1') AS e1,
  (SELECT id FROM harness.ids WHERE k='e2') AS e2,
  (SELECT id FROM harness.ids WHERE k='e3') AS e3,
  (SELECT id FROM harness.ids WHERE k='e4') AS e4,
  (SELECT id FROM harness.ids WHERE k='eb1') AS eb1 \gset
\set loc_a '''':loc_a''''
\set loc_b '''':loc_b''''
\set league_a '''':league_a''''
\set league_b '''':league_b''''
\set course_a '''':course_a''''
\set course_b '''':course_b''''
\set p1 '''':p1''''
\set p2 '''':p2''''
\set p3 '''':p3''''
\set p4 '''':p4''''
\set p5 '''':p5''''
\set p6 '''':p6''''
\set p7 '''':p7''''
